# Copie para .env e preencha os valores reais.
# NUNCA commite o .env no Git.

# ── Banco de dados ─────────────────────────────────────────────────────────────
DB_NAME=sosvideos
DB_USERNAME=sosvideos_user
DB_PASSWORD=troque_para_senha_forte

# ── JWT ────────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
JWT_SECRET=cole_aqui_o_resultado_do_openssl
# Tempo de expiração em milissegundos (86400000 = 24h)
JWT_EXPIRATION=86400000

# ── Admin inicial (seed do banco) ──────────────────────────────────────────────
ADMIN_E=admin@seudominio.com
ADMIN_P=senha_forte_do_admin

# ── Kiwify ─────────────────────────────────────────────────────────────────────
KIWIFY_WEBHOOK_SECRET=segredo_configurado_no_painel_kiwify

# ── CORS ───────────────────────────────────────────────────────────────────────
# Domínio(s) do frontend separados por vírgula
APP_CORS_ALLOWED_ORIGINS=https://sosvideos.com,https://www.sosvideos.com
